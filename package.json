{
  "name": "js-playwright-bdd-example",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "node demo-app/server.js",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && gherkin-lint-plus",
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:regression": "bddgen && playwright test",
    "test:ui": "bddgen && playwright test --ui",
    "report": "playwright show-report"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.feature": [
      "prettier --write",
      "gherkin-lint-plus"
    ],
    "*.{md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "gherkin-lint-plus": "^1.0.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-gherkin": "^4.0.0"
  }
}
